---
import { NOVEDADES } from '../data/siteData';
import Countdown from './Countdown.astro';
---

<section id="noticias" class="py-16 px-4 max-w-7xl mx-auto relative z-10 border-t border-white/5">
  <div class="text-center mb-10 space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FF6D00]/20 border border-[#FF9100]/40">
      <span class="w-2 h-2 rounded-full bg-[#FF9100] animate-ping"></span>
      <span class="text-xs uppercase tracking-[0.25em] font-bold text-[#FFD700]">Eventos Próximos</span>
    </div>
    <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">
      Novedades <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFD700] via-[#FF9100] to-[#FF3D00]">& Anuncios</span>
    </h2>
  </div>

  <div id="carousel-container" class="relative max-w-5xl mx-auto overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/5 to-white/[0.02] backdrop-blur-xl shadow-[0_0_50px_rgba(0,0,0,0.8)] group">
    
    <div id="carousel-track" class="flex transition-transform duration-700 ease-in-out">
      {NOVEDADES.map((item) => (
        <div class="min-w-full grid lg:grid-cols-12 gap-8 p-6 sm:p-10 items-center">
          
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative group rounded-2xl overflow-hidden border border-white/20 shadow-2xl max-w-xs sm:max-w-sm w-full">
              <img src={item.imagen} alt={item.titulo} class="w-full h-auto object-cover" />
            </div>
          </div>

          <div class="lg:col-span-7 space-y-5 text-left">
            <div>
              <span class="text-xs font-black uppercase tracking-widest text-[#FF9100] bg-[#FF9100]/10 px-3 py-1 rounded-md border border-[#FF9100]/30 inline-block mb-3">
                {item.fecha}
              </span>
              <h3 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white leading-tight">
                {item.titulo}
              </h3>
              <p class="text-sm sm:text-base text-[#FFD700] font-semibold italic mt-1">
                "{item.subtitulo}"
              </p>
            </div>

            <div class="space-y-2 border-l-2 border-[#FF9100] pl-4 py-1">
              <p class="text-xs sm:text-sm text-zinc-300 font-medium">
                <strong class="text-white">Programa / Invitados:</strong> {item.invitados}
              </p>
              <p class="text-xs text-zinc-400 font-light leading-relaxed">
                {item.detalle}
              </p>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a 
                href={item.linkBtn} 
                target="_blank" 
                rel={item.isExternal ? "noopener noreferrer" : ""}
                class="bg-gradient-to-r from-[#FF9100] to-[#FF3D00] hover:brightness-110 text-white font-extrabold px-6 py-3.5 rounded-xl text-xs uppercase tracking-widest transition shadow-[0_0_20px_rgba(255,109,0,0.4)] flex items-center justify-center gap-2 shrink-0"
              >
                <span>{item.btnText}</span>
              </a>

              {item.targetDate && <Countdown targetDate={item.targetDate} />}
            </div>

          </div>

        </div>
      ))}
    </div>

    <button id="prev-btn" class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/90 text-white p-2.5 rounded-full border border-white/20 transition backdrop-blur-md z-20" aria-label="Anterior">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button id="next-btn" class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black/90 text-white p-2.5 rounded-full border border-white/20 transition backdrop-blur-md z-20" aria-label="Siguiente">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>

    <div id="dots-container" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20"></div>
  </div>
</section>