---
// src/pages/index.astro
const WSP_NUMBER = "5493411234567"; // Modificar por el número real de WhatsApp de la iglesia
const WSP_MESSAGE = encodeURIComponent("¡Hola! Quisiera más información sobre las reuniones del Ministerio Catedral de Fuego.");
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ministerio Catedral de Fuego | Rosario, Santa Fe</title>
  <meta name="description" content="Bienvenido al Ministerio Catedral de Fuego en Rosario, Santa Fe. Un lugar de fe, restauración y comunidad." />
  
  <!-- Open Graph para vista previa en WhatsApp -->
  <meta property="og:title" content="Ministerio Catedral de Fuego - Rosario" />
  <meta property="og:description" content="Un lugar de fe y comunidad en Rosario, Santa Fe. Conocé nuestras reuniones y conectate con nosotros." />
  <meta property="og:image" content="/images/og-catedral.jpg" />
  <meta property="og:type" content="website" />

  <!-- Carga de tipografía elegante estilo Serif para el logo -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- Script CDN de Tailwind CSS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#121212] text-[#FDFBF7] font-sans antialiased min-h-screen">

  <!-- Encabezado / Navegación Móvil y Desktop Limpio -->
  <header class="sticky top-0 z-40 bg-[#121212]/95 backdrop-blur-md border-b border-[#FF6D00]/20">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3 flex justify-between items-center gap-2">
      <a href="#" class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Icono Llama Vectorial -->
        <svg class="w-6 h-7 sm:w-8 sm:h-9" viewBox="0 0 50 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 12,50 C 5,35 10,20 20,5 C 22,25 32,20 30,0 C 45,15 48,35 38,50 C 48,35 45,15 35,10 C 25,35 15,35 12,50 Z" fill="url(#headerFlame)" />
          <defs>
            <linearGradient id="headerFlame" x1="0" y1="60" x2="0" y2="0" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FF3D00"/>
              <stop offset="0.5" stop-color="#FF9100"/>
              <stop offset="1" stop-color="#FFEA00"/>
            </linearGradient>
          </defs>
        </svg>
        <div class="flex flex-col leading-none">
          <span class="text-[8px] sm:text-[10px] tracking-[0.2em] text-[#D1C7BD] font-semibold uppercase" style="font-family: 'Cinzel', serif;">Ministerio</span>
          <span class="text-sm sm:text-lg font-bold tracking-wide text-[#FDFBF7] uppercase" style="font-family: 'Cinzel', serif;">
            Catedral <span class="text-[#FF6D00]">de Fuego</span>
          </span>
        </div>
      </a>

      <nav class="hidden md:flex gap-6 text-sm font-medium text-[#D1C7BD]">
        <a href="#inicio" class="hover:text-[#FF6D00] transition">Inicio</a>
        <a href="#reuniones" class="hover:text-[#FF6D00] transition">Horarios</a>
        <a href="#contacto" class="hover:text-[#FF6D00] transition">Ubicación</a>
      </nav>

      <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="bg-[#FF6D00] hover:bg-orange-600 text-white font-semibold text-xs sm:text-sm px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-full transition shadow-lg shadow-orange-950/40 flex items-center gap-1.5 shrink-0">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Escribinos</span>
      </a>
    </div>
  </header>

  <!-- Hero Section con Capa Oscura Protegida -->
  <section id="inicio" class="relative min-h-[85vh] flex items-center justify-center bg-cover bg-center text-center px-4 overflow-hidden" style="background-image: linear-gradient(to bottom, rgba(18,18,18,0.70), rgba(18,18,18,0.70)), url('/images/hero-catedral.jpg');">
    <div class="max-w-3xl mx-auto space-y-5 py-12 relative z-10">
      
      <!-- Badge Rosario -->
      <div>
        <span class="inline-block px-3.5 py-1 bg-[#FF6D00]/20 border border-[#FF6D00]/40 text-[#FF6D00] rounded-full text-[11px] font-semibold tracking-widest uppercase">
          Rosario, Santa Fe
        </span>
      </div>

      <!-- Título Principal -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-[#FDFBF7] leading-tight px-2">
        Un lugar de fe, esperanza y <span class="text-[#FF6D00]">transformación</span>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-[#D1C7BD] max-w-2xl mx-auto font-light px-2">
        Te damos la bienvenida al Ministerio Catedral de Fuego. Te invitamos a compartir nuestras reuniones y ser parte de nuestra comunidad.
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-col sm:flex-row justify-center gap-3 pt-4 px-4">
        <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="bg-[#FF6D00] hover:bg-orange-600 text-white font-bold px-6 py-3.5 rounded-lg text-base sm:text-lg transition flex items-center justify-center gap-2 shadow-lg shadow-orange-950/50">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          Contactar por WhatsApp
        </a>
        <a href="#reuniones" class="border border-[#FF6D00]/50 hover:border-[#FF6D00] text-[#FDFBF7] hover:text-white font-semibold px-6 py-3.5 rounded-lg text-base sm:text-lg transition">
          Ver Horarios
        </a>
      </div>
    </div>
  </section>

  <!-- Sección Horarios y Actividades -->
  <section id="reuniones" class="py-16 sm:py-20 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-10 sm:mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-[#FDFBF7]">Nuestras <span class="text-[#FF6D00]">Reuniones</span></h2>
      <p class="text-[#D1C7BD] mt-2">Sumate a nuestros encuentros presenciales en Rosario</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-[#1E1E1E] p-6 rounded-xl border border-[#FF6D00]/10 hover:border-[#FF6D00]/40 transition">
        <div class="text-[#FF6D00] text-xl sm:text-2xl font-bold mb-2">Reunión General</div>
        <p class="text-[#FDFBF7] font-medium">Domingos - 19:00 hs</p>
        <p class="text-sm text-[#D1C7BD] mt-3">Un tiempo especial de alabanza, predicación y comunión familiar.</p>
      </div>
      <div class="bg-[#1E1E1E] p-6 rounded-xl border border-[#FF6D00]/10 hover:border-[#FF6D00]/40 transition">
        <div class="text-[#FF6D00] text-xl sm:text-2xl font-bold mb-2">Escuela de Líderes</div>
        <p class="text-[#FDFBF7] font-medium">Miércoles - 20:00 hs</p>
        <p class="text-sm text-[#D1C7BD] mt-3">Capacitación y estudio profundo de la Palabra de Dios.</p>
      </div>
      <div class="bg-[#1E1E1E] p-6 rounded-xl border border-[#FF6D00]/10 hover:border-[#FF6D00]/40 transition">
        <div class="text-[#FF6D00] text-xl sm:text-2xl font-bold mb-2">Jóvenes</div>
        <p class="text-[#FDFBF7] font-medium">Sábados - 18:30 hs</p>
        <p class="text-sm text-[#D1C7BD] mt-3">Encuentro de la juventud con música, charlas y actividades grupales.</p>
      </div>
    </div>
  </section>

  <!-- Sección Ubicación y Mapa -->
  <section id="contacto" class="py-16 sm:py-20 px-4 max-w-6xl mx-auto border-t border-[#FF6D00]/10">
    <div class="text-center mb-10 sm:mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-[#FDFBF7]">Dónde <span class="text-[#FF6D00]">Estamos</span></h2>
      <p class="text-[#D1C7BD] mt-2">Visitanos en nuestra sede del Ministerio Catedral de Fuego</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-center">
      <!-- Datos de Dirección y Contacto -->
      <div class="bg-[#1E1E1E] p-6 sm:p-8 rounded-xl border border-[#FF6D00]/20 space-y-6">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[#FF6D00]">Dirección</h3>
          <p class="text-[#FDFBF7] mt-1 font-medium">Ministerio Catedral de Fuego</p>
          <p class="text-[#D1C7BD] text-sm">Rosario, Santa Fe, Argentina</p>
        </div>
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[#FF6D00]">Atención y Consultas</h3>
          <p class="text-[#D1C7BD] text-sm sm:text-base mt-1">Escribinos por WhatsApp para coordinar una visita o pedir oración.</p>
        </div>
        <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="inline-flex items-center justify-center gap-2 bg-[#FF6D00] hover:bg-orange-600 text-white font-bold px-6 py-3 rounded-lg transition shadow-lg w-full sm:w-auto">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          Enviar mensaje directo
        </a>
      </div>

      <!-- Mapa Interactivo -->
      <div class="w-full h-80 rounded-xl overflow-hidden border border-[#FF6D00]/20 shadow-lg">
        <iframe 
          class="w-full h-full border-0" 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3347.1484817110595!2d-60.63455309999999!3d-32.9734842!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95b7abb46288503d%3A0x5216989f35114105!2sMinisterio%20Catedral%20de%20Fuego!5e0!3m2!1ses!2sar!4v1790606273133!5m2!1ses!2sar" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

  <!-- Botón Flotante de WhatsApp -->
  <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="fixed bottom-5 right-5 z-50 bg-green-600 hover:bg-green-500 text-white p-3.5 sm:p-4 rounded-full shadow-2xl transition transform hover:scale-110 flex items-center justify-center" aria-label="WhatsApp">
    <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
  </a>

  <!-- Pie de Página -->
  <footer class="bg-black/80 py-8 sm:py-10 border-t border-[#FF6D00]/20 text-center text-xs sm:text-sm text-[#D1C7BD] px-4">
    <p>© {new Date().getFullYear()} Ministerio Catedral de Fuego - Rosario, Santa Fe. Todos los derechos reservados.</p>
  </footer>

</body>
</html>