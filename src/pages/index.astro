---
// src/pages/index.astro
const WSP_NUMBER = "5493413489281"; // Modificar por el número real con código de área de Rosario (341)
const WSP_MESSAGE = encodeURIComponent("¡Hola! Quisiera más información sobre las reuniones del Ministerio Catedral de Fuego.");
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ministerio Catedral de Fuego | Rosario, Santa Fe</title>
  <meta name="description" content="¡Sé parte de la familia de Catedral de Fuego! Te esperamos en nuestras reuniones en Rosario, Santa Fe." />
  
  <!-- Open Graph para vista previa en WhatsApp -->
  <meta property="og:title" content="Ministerio Catedral de Fuego - Rosario" />
  <meta property="og:description" content="¡Sé parte de la familia de Catedral de Fuego! Te esperamos en Rosario, Santa Fe." />
  <meta property="og:image" content="/images/pastores-catedral.jpg" />
  <meta property="og:type" content="website" />

  <!-- Tipografías de Alto Impacto Estilo RAF -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Montserrat:wght@300;400;600;800;900&family=Great+Vibes&display=swap" rel="stylesheet">

  <!-- Script CDN de Tailwind CSS -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0A0A0B] text-[#F3F3F5] font-['Montserrat',sans-serif] antialiased min-h-screen selection:bg-[#FF6D00] selection:text-white overflow-x-hidden">

  <!-- Glows de Fondo Iluminación Fuego/Dorado (Estilo RAF) -->
  <div class="fixed top-[-100px] left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-r from-[#FF6D00]/20 to-[#FFD700]/10 blur-[150px] pointer-events-none z-0"></div>
  <div class="fixed bottom-0 right-0 w-[450px] h-[450px] bg-[#FF3D00]/10 blur-[180px] pointer-events-none z-0"></div>

  <!-- Encabezado / Navegación -->
  <header class="sticky top-0 z-50 bg-[#0A0A0B]/90 backdrop-blur-xl border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex justify-between items-center">
      <a href="#" class="flex items-center gap-3 group">
        <!-- Logo Llama con Degradado Fuego Perfecto -->
        <svg class="w-8 h-9 transition transform group-hover:scale-105 filter drop-shadow-[0_0_12px_rgba(255,109,0,0.6)]" viewBox="0 0 50 60" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 12,50 C 5,35 10,20 20,5 C 22,25 32,20 30,0 C 45,15 48,35 38,50 C 48,35 45,15 35,10 C 25,35 15,35 12,50 Z" fill="url(#headerFlame)" />
          <defs>
            <linearGradient id="headerFlame" x1="0" y1="60" x2="0" y2="0" gradientUnits="userSpaceOnUse">
              <stop stop-color="#FF3D00"/>
              <stop offset="0.5" stop-color="#FF9100"/>
              <stop offset="1" stop-color="#FFEA00"/>
            </linearGradient>
          </defs>
        </svg>
        <div class="flex flex-col leading-none">
          <span class="text-[9px] tracking-[0.3em] text-zinc-400 font-bold uppercase" style="font-family: 'Cinzel', serif;">Ministerio</span>
          <span class="text-base sm:text-lg font-black tracking-wider text-white uppercase" style="font-family: 'Cinzel', serif;">
            Catedral <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFD700] via-[#FF9100] to-[#FF3D00]">de Fuego</span>
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-xs tracking-widest uppercase font-semibold text-zinc-400">
        <a href="#inicio" class="hover:text-white transition">Inicio</a>
        <a href="#pastores" class="hover:text-white transition">Bienvenida</a>
        <a href="#reuniones" class="hover:text-white transition">Horarios</a>
        <a href="#contacto" class="hover:text-white transition">Ubicación</a>
      </nav>

      <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="bg-gradient-to-r from-[#FF9100] to-[#FF3D00] hover:brightness-110 text-white font-bold text-xs tracking-wider uppercase px-5 py-2.5 rounded-full transition-all shadow-[0_0_25px_rgba(255,109,0,0.4)] flex items-center gap-2">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Escribinos</span>
      </a>
    </div>
  </header>

  <!-- Hero Section Con la Imagen de los Pastores Estilo RAF -->
  <section id="inicio" class="relative min-h-[92vh] flex items-center justify-center py-12 px-4 sm:px-6 relative z-10">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna Texto y Slogan -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Badge Rosario -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md shadow-2xl">
          <span class="w-2 h-2 rounded-full bg-[#FF9100] animate-pulse"></span>
          <span class="text-xs uppercase tracking-[0.25em] font-semibold text-zinc-300">Rosario · Santa Fe</span>
        </div>

        <!-- Frase Principal tomada de la foto oficial -->
        <div class="space-y-2">
          <p class="text-2xl sm:text-3xl text-[#FFD700] font-normal italic tracking-wide" style="font-family: 'Great Vibes', cursive;">
            ¡Sé parte de la
          </p>
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white leading-[1.02]">
            Familia <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFD700] via-[#FF9100] to-[#FF3D00]">de Catedral de Fuego</span>
          </h1>
        </div>

        <p class="text-base sm:text-lg text-zinc-300 max-w-xl mx-auto lg:mx-0 font-light leading-relaxed">
          Un lugar de fe, restauración y avivamiento. Te abrimos las puertas para compartir juntos la Palabra de Dios y transformar nuestras familias.
        </p>

        <!-- Botones de Acción -->
        <div class="flex flex-col sm:flex-row justify-center lg:justify-start items-center gap-4 pt-4">
          <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="w-full sm:w-auto bg-gradient-to-r from-[#FF9100] to-[#FF3D00] hover:brightness-110 text-white font-extrabold px-8 py-4 rounded-xl text-xs uppercase tracking-widest transition-all shadow-[0_0_35px_rgba(255,109,0,0.4)] flex items-center justify-center gap-3">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            <span>Contactar por WhatsApp</span>
          </a>
          <a href="#reuniones" class="w-full sm:w-auto bg-white/5 hover:bg-white/10 text-white border border-white/10 font-bold px-8 py-4 rounded-xl text-xs uppercase tracking-widest transition-all backdrop-blur-md">
            Ver Horarios
          </a>
        </div>
      </div>

      <!-- Columna Foto de Pastores Estilo Marco RAF con Glow Dorado -->
      <div id="pastores" class="lg:col-span-5 relative flex justify-center">
        <!-- Anillo Glow de fondo -->
        <div class="absolute inset-0 rounded-3xl bg-gradient-to-tr from-[#FF3D00]/30 via-[#FF9100]/20 to-[#FFD700]/30 blur-2xl -z-10"></div>
        
        <!-- Tarjeta Marco Elegante -->
        <div class="relative rounded-2xl overflow-hidden border border-white/15 p-2 bg-gradient-to-b from-white/10 to-transparent backdrop-blur-md shadow-2xl group max-w-md w-full">
          <img 
            src="/images/pastores-catedral.jpg" 
            alt="Pastores Ministerio Catedral de Fuego Rosario" 
            class="w-full h-auto rounded-xl object-cover transition transform duration-500 group-hover:scale-102"
          />
          <div class="absolute bottom-4 left-4 right-4 bg-[#0A0A0B]/90 backdrop-blur-md border border-white/10 p-3.5 rounded-xl text-center">
            <p class="text-xs font-bold uppercase tracking-widest text-[#FFD700]">Ministerio Pastoral</p>
            <p class="text-xs text-zinc-300 font-light mt-0.5">Te esperamos con los brazos abiertos</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Sección Horarios con Tarjetas Estilo RAF -->
  <section id="reuniones" class="py-20 px-4 max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-14 space-y-2">
      <span class="text-xs uppercase tracking-[0.3em] font-bold text-[#FF9100]">Encuentros Presenciales</span>
      <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Nuestras <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFD700] to-[#FF3D00]">Reuniones</span></h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="group bg-gradient-to-b from-white/5 to-white/[0.02] p-8 rounded-2xl border border-white/10 hover:border-[#FF9100]/50 transition-all duration-300 backdrop-blur-md relative overflow-hidden">
        <div class="w-12 h-12 rounded-xl bg-[#FF6D00]/10 border border-[#FF6D00]/30 flex items-center justify-center text-[#FFD700] font-black text-xl mb-6">01</div>
        <h3 class="text-xl font-black uppercase text-white tracking-wide mb-1">Reunión General</h3>
        <p class="text-xs font-semibold text-[#FF9100] uppercase tracking-wider">Domingos · 19:00 hs</p>
        <p class="text-xs text-zinc-400 mt-4 leading-relaxed font-light">Un tiempo especial de alabanza, predicación de la Palabra y comunión familiar en presencia de Dios.</p>
      </div>

      <div class="group bg-gradient-to-b from-white/5 to-white/[0.02] p-8 rounded-2xl border border-white/10 hover:border-[#FF9100]/50 transition-all duration-300 backdrop-blur-md relative overflow-hidden">
        <div class="w-12 h-12 rounded-xl bg-[#FF6D00]/10 border border-[#FF6D00]/30 flex items-center justify-center text-[#FFD700] font-black text-xl mb-6">02</div>
        <h3 class="text-xl font-black uppercase text-white tracking-wide mb-1">Escuela de Líderes</h3>
        <p class="text-xs font-semibold text-[#FF9100] uppercase tracking-wider">Miércoles · 20:00 hs</p>
        <p class="text-xs text-zinc-400 mt-4 leading-relaxed font-light">Capacitación teológica y estudio profundo para el desarrollo de servidores y líderes de hogar.</p>
      </div>

      <div class="group bg-gradient-to-b from-white/5 to-white/[0.02] p-8 rounded-2xl border border-white/10 hover:border-[#FF9100]/50 transition-all duration-300 backdrop-blur-md relative overflow-hidden">
        <div class="w-12 h-12 rounded-xl bg-[#FF6D00]/10 border border-[#FF6D00]/30 flex items-center justify-center text-[#FFD700] font-black text-xl mb-6">03</div>
        <h3 class="text-xl font-black uppercase text-white tracking-wide mb-1">Jóvenes de Fuego</h3>
        <p class="text-xs font-semibold text-[#FF9100] uppercase tracking-wider">Sábados · 18:30 hs</p>
        <p class="text-xs text-zinc-400 mt-4 leading-relaxed font-light">Un espacio vibrante para la juventud con música en vivo, charlas y dinámicas para fortalecer la fe.</p>
      </div>
    </div>
  </section>

  <!-- Sección Ubicación y Mapa -->
  <section id="contacto" class="py-20 px-4 max-w-7xl mx-auto border-t border-white/5 relative z-10">
    <div class="text-center mb-14 space-y-2">
      <span class="text-xs uppercase tracking-[0.3em] font-bold text-[#FF9100]">Sede Rosario</span>
      <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Dónde <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFD700] to-[#FF3D00]">Estamos</span></h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div class="bg-gradient-to-b from-white/5 to-white/[0.02] p-8 sm:p-10 rounded-2xl border border-white/10 space-y-8 backdrop-blur-md">
        <div>
          <span class="text-xs uppercase tracking-widest text-[#FF9100] font-bold">Dirección Oficial</span>
          <h3 class="text-2xl font-black uppercase text-white mt-1">Ministerio Catedral de Fuego</h3>
          <p class="text-zinc-400 text-sm mt-1">Rosario, Santa Fe, Argentina</p>
        </div>

        <div>
          <span class="text-xs uppercase tracking-widest text-[#FF9100] font-bold">Atención y Oración</span>
          <p class="text-zinc-300 text-sm mt-1 font-light leading-relaxed">Coordiná tu visita o envianos tus intenciones directamente a nuestro equipo pastoral.</p>
        </div>

        <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="w-full inline-flex items-center justify-center gap-3 bg-gradient-to-r from-[#FF9100] to-[#FF3D00] hover:brightness-110 text-white font-extrabold px-8 py-4 rounded-xl text-xs uppercase tracking-widest transition shadow-[0_0_25px_rgba(255,109,0,0.3)]">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          Enviar mensaje directo
        </a>
      </div>

      <!-- Mapa Interactivo -->
      <div class="w-full h-96 rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative">
        <iframe 
          class="w-full h-full border-0 grayscale opacity-85 hover:grayscale-0 hover:opacity-100 transition-all duration-500" 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3347.1484817110595!2d-60.63455309999999!3d-32.9734842!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95b7abb46288503d%3A0x5216989f35114105!2sMinisterio%20Catedral%20de%20Fuego!5e0!3m2!1ses!2sar!4v1790606273133!5m2!1ses!2sar" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

  <!-- Botón Flotante de WhatsApp -->
  <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="fixed bottom-6 right-6 z-50 bg-green-600 hover:bg-green-500 text-white p-4 rounded-full shadow-[0_0_30px_rgba(34,197,94,0.4)] transition transform hover:scale-110 flex items-center justify-center" aria-label="WhatsApp">
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
  </a>

  <!-- Pie de Página -->
  <footer class="bg-black py-10 border-t border-white/5 text-center text-xs text-zinc-500 px-4">
    <p>© {new Date().getFullYear()} Ministerio Catedral de Fuego - Rosario, Santa Fe. Todos los derechos reservados.</p>
  </footer>

</body>
</html>
