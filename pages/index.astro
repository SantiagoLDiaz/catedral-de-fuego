---
import '../styles/global.css';

import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Carousel from '../components/Carousel.astro';
import MediaSection from '../components/MediaSection.astro';
import Schedules from '../components/Schedules.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ministerio Catedral de Fuego | Rosario, Santa Fe</title>
  <meta name="description" content="Un lugar de fe, restauración y avivamiento en Rosario, Santa Fe." />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Montserrat:wght@400;600;800;900&display=swap" rel="stylesheet">
</head>
<body class="bg-[#0A0A0B] text-[#F3F3F5] font-['Montserrat',sans-serif] antialiased min-h-screen selection:bg-[#FF6D00] selection:text-white overflow-x-hidden">

  <Header />
  
  <main>
    <Hero />
    <Carousel />
    <MediaSection />
    <Schedules />
    <Location />
  </main>

  <Footer />

  <script>
    import { initMenu } from '../scripts/menu.js';
    import { initCountdowns } from '../scripts/countdown.js';
    import { initCarousel } from '../scripts/carousel.js';

    document.addEventListener('DOMContentLoaded', () => {
      initMenu();
      initCountdowns();
      initCarousel();
    });
  </script>
</body>
</html>