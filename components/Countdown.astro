---
interface Props {
  targetDate: string;
}

const { targetDate } = Astro.props;
---

<div class="bg-black/60 border border-[#FF9100]/40 rounded-xl px-4 py-2.5 backdrop-blur-md flex items-center justify-center sm:justify-start gap-3 shadow-lg">
  <div class="relative flex h-3 w-3 shrink-0">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FF3D00] opacity-75"></span>
    <span class="relative inline-flex rounded-full h-3 w-3 bg-[#FF3D00]"></span>
  </div>

  <div class="countdown-timer flex items-center gap-1.5 font-black text-sm sm:text-base text-white tracking-tight" data-target={targetDate}>
    <div class="flex items-baseline gap-0.5">
      <span class="days text-[#FFD700] text-base sm:text-lg">00</span>
      <span class="text-[9px] uppercase font-bold text-zinc-400">d</span>
    </div>
    <span class="text-[#FF9100] text-xs font-bold">:</span>
    
    <div class="flex items-baseline gap-0.5">
      <span class="hours text-base sm:text-lg">00</span>
      <span class="text-[9px] uppercase font-bold text-zinc-400">h</span>
    </div>
    <span class="text-[#FF9100] text-xs font-bold">:</span>
    
    <div class="flex items-baseline gap-0.5">
      <span class="minutes text-base sm:text-lg">00</span>
      <span class="text-[9px] uppercase font-bold text-zinc-400">m</span>
    </div>
    <span class="text-[#FF9100] text-xs font-bold">:</span>
    
    <div class="flex items-baseline gap-0.5">
      <span class="seconds text-[#FF3D00] text-base sm:text-lg">00</span>
      <span class="text-[9px] uppercase font-bold text-zinc-400">s</span>
    </div>
  </div>
</div>