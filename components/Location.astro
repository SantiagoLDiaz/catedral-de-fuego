---
import { SOCIAL_LINKS, WSP_NUMBER, WSP_MESSAGE } from '../data/siteData';
---

<section id="contacto" class="py-20 px-4 max-w-7xl mx-auto border-t border-white/5 relative z-10">
  <div class="text-center mb-14 space-y-2">
    <span class="text-xs uppercase tracking-[0.3em] font-bold text-[#FF9100]">Sede Rosario</span>
    <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">Dónde <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFD700] to-[#FF3D00]">Estamos</span></h2>
  </div>

  <div class="grid md:grid-cols-2 gap-8 items-center">
    <div class="bg-gradient-to-b from-white/5 to-white/[0.02] p-8 sm:p-10 rounded-2xl border border-white/10 space-y-8 backdrop-blur-md">
      <div>
        <span class="text-xs uppercase tracking-widest text-[#FF9100] font-bold">Dirección Oficial</span>
        <h3 class="text-2xl font-black uppercase text-white mt-1">Ministerio Catedral de Fuego</h3>
        <p class="text-zinc-400 text-sm mt-1">Rosario, Santa Fe, Argentina</p>
      </div>

      <div>
        <span class="text-xs uppercase tracking-widest text-[#FF9100] font-bold">Nuestras Redes Oficiales</span>
        <div class="flex flex-wrap gap-3 mt-4">
          <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-white/5 hover:bg-[#FF0000]/20 border border-white/10 hover:border-[#FF0000]/40 text-xs font-semibold px-4 py-2.5 rounded-lg transition text-zinc-200">YouTube</a>
          <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-white/5 hover:bg-[#1877F2]/20 border border-white/10 hover:border-[#1877F2]/40 text-xs font-semibold px-4 py-2.5 rounded-lg transition text-zinc-200">Facebook</a>
          <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-white/5 hover:bg-[#E4405F]/20 border border-white/10 hover:border-[#E4405F]/40 text-xs font-semibold px-4 py-2.5 rounded-lg transition text-zinc-200">Instagram</a>
        </div>
      </div>

      <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-3 bg-gradient-to-r from-[#FF9100] to-[#FF3D00] hover:brightness-110 text-white font-extrabold px-8 py-4 rounded-xl text-xs uppercase tracking-widest transition shadow-[0_0_25px_rgba(255,109,0,0.3)]">
        Enviar mensaje directo
      </a>
    </div>

    <div class="w-full h-96 rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative">
      <iframe 
        class="w-full h-full border-0" 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3347.1484817110595!2d-60.63455309999999!3d-32.9734842!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95b7abb46288503d%3A0x5216989f35114105!2sMinisterio%20Catedral%20de%20Fuego!5e0!3m2!1ses!2sar!4v1790606273133!5m2!1ses!2sar" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div>
</section>