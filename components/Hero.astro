---
import { WSP_NUMBER, WSP_MESSAGE } from '../data/siteData';
---

<section id="inicio" 
  class="relative min-h-[88vh] flex items-end sm:items-center justify-start text-left px-4 sm:px-12 z-10 overflow-hidden bg-cover bg-[position:50%_0%] lg:bg-[size:88%] lg:bg-[position:100%_40%] md:bg-right-top" 
  style="background-image: 
    linear-gradient(to top, rgba(10,10,11,0.95) 0%, rgba(10,10,11,0.5) 50%, rgba(10,10,11,0.1) 100%), 
    linear-gradient(to right, rgba(10,10,11,0.5) 0%, rgba(10,10,11,0) 60%, rgba(10,10,11,0) 100%), 
    url('/images/pastores-catedral.jpg');"
>
  <div class="max-w-xl py-12 sm:py-20 relative z-20 space-y-5">
    <div class="mt-4 sm:mt-6 space-y-2">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-md bg-[#FF6D00]/20 border-l-2 sm:border-l-4 border-[#FF9100] backdrop-blur-md">
        <span class="text-[10px] sm:text-xs uppercase tracking-[0.15em] sm:tracking-[0.2em] font-bold text-[#FFD700]">
          Rosario · Santa Fe
        </span>
      </div>
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white leading-[1.08] drop-shadow-xl">
      Un lugar de fe, <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFD700] via-[#FF9100] to-[#FF3D00]">esperanza y transformación</span>
    </h1>

    <p class="text-sm sm:text-base text-zinc-300 font-light leading-relaxed drop-shadow-md max-w-lg">
      ¡Sé parte de la familia de Catedral de Fuego! Te abrimos las puertas para compartir juntos la Palabra de Dios y transformar nuestras familias.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-3">
      <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" rel="noopener noreferrer" class="bg-gradient-to-r from-[#FF9100] to-[#FF3D00] hover:brightness-110 text-white font-extrabold px-7 py-3.5 rounded-xl text-xs uppercase tracking-widest transition-all shadow-[0_0_30px_rgba(255,109,0,0.4)] flex items-center justify-center gap-2.5">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Contactar por WhatsApp</span>
      </a>
      <a href="#reuniones" class="bg-black/50 hover:bg-black/70 text-white border border-white/20 font-bold px-7 py-3.5 rounded-xl text-xs uppercase tracking-widest transition-all backdrop-blur-md text-center">
        Ver Horarios
      </a>
    </div>
  </div>
</section>